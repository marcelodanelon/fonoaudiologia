#!/bin/sh
# Maven Wrapper startup script for Unix
# Downloads Maven Wrapper JAR if needed

set -e

MAVEN_PROJECTDIR="$(cd "$(dirname "$0")" && pwd)"
MAVEN_OPTS="${MAVEN_OPTS:--Xmx512m}"

WRAPPER_JAR="$MAVEN_PROJECTDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$MAVEN_PROJECTDIR/.mvn/wrapper/maven-wrapper.properties"
WRAPPER_URL=$(grep 'distributionUrl' "$WRAPPER_PROPERTIES" | sed 's/.*=//')

if [ ! -f "$WRAPPER_JAR" ]; then
    echo "Downloading Maven Wrapper..."
    curl -fsSL -o "$WRAPPER_JAR" "$WRAPPER_URL" 2>/dev/null || \
    wget -q -O "$WRAPPER_JAR" "$WRAPPER_URL" 2>/dev/null || \
    fetch -o "$WRAPPER_JAR" "$WRAPPER_URL" 2>/dev/null || \
    { echo "Error: Failed to download Maven Wrapper"; exit 1; }
fi

exec java $MAVEN_OPTS -jar "$WRAPPER_JAR" "$@"
